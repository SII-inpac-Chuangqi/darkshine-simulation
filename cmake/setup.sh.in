#!/bin/bash
#
# Setup script for DarkSHINE Software Package (DSS)
# Auto-generated by CMake during build
#
# Usage: source setup.sh
#

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Set DSS_DIR to the installation directory
export DSS_DIR="${SCRIPT_DIR}"

# Add DSS binaries to PATH
if [[ ":$PATH:" != *":${DSS_DIR}/bin:"* ]]; then
    export PATH="${DSS_DIR}/bin:${PATH}"
fi

# Add DSS libraries to LD_LIBRARY_PATH (Linux) or DYLD_LIBRARY_PATH (macOS)
if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS
    if [[ ":$DYLD_LIBRARY_PATH:" != *":${DSS_DIR}/lib:"* ]]; then
        export DYLD_LIBRARY_PATH="${DSS_DIR}/lib:${DYLD_LIBRARY_PATH}"
    fi
else
    # Linux
    if [[ ":$LD_LIBRARY_PATH:" != *":${DSS_DIR}/lib:"* ]]; then
        export LD_LIBRARY_PATH="${DSS_DIR}/lib:${LD_LIBRARY_PATH}"
    fi
fi

echo "DarkSHINE Software Package environment setup:"
echo "  DSS_DIR: ${DSS_DIR}"
echo "  PATH: ${DSS_DIR}/bin added to PATH"
if [[ "$OSTYPE" == "darwin"* ]]; then
    echo "  DYLD_LIBRARY_PATH: ${DSS_DIR}/lib added to DYLD_LIBRARY_PATH"
else
    echo "  LD_LIBRARY_PATH: ${DSS_DIR}/lib added to LD_LIBRARY_PATH"
fi
echo ""
echo "DSS setup complete!"